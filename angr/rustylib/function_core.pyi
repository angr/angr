from typing import Any, Self

from .function_graph import FunctionGraph

class FunctionCore:
    """
    The plain-data state of a Function: address, names, flags, returning status, dirty bookkeeping and the
    FunctionGraph. Attribute names are those of the former Function slots.
    """

    addr: int
    _name: str
    is_default_name: bool
    previous_names: list[str]
    binary_name: str | None
    _from_signature: str | None
    _prototype_libname: str | None
    _is_syscall: bool
    _is_simprocedure: bool
    _is_plt: bool
    _is_alignment: bool
    _returning: bool | None
    normalized: bool
    ran_cca: bool
    bp_on_stack: bool
    retaddr_on_stack: bool
    _dirty: bool
    meta_only: bool
    evicted: bool
    _graph: FunctionGraph | None
    is_plt: bool
    is_simprocedure: bool
    is_syscall: bool
    is_alignment: bool

    def __new__(cls, *args: Any, **kwargs: Any) -> Self: ...
    @property
    def name(self) -> str: ...
    @property
    def returning(self) -> bool | None: ...
    @property
    def from_signature(self) -> str | None: ...
    @property
    def prototype_libname(self) -> str | None: ...
    @property
    def dirty(self) -> bool: ...
    def mark_dirty(self) -> None: ...
    def _add_previous_name(self, name: str) -> None: ...
    def _core_state(self) -> dict[str, Any]: ...

class FunctionIndex:
    """
    The ordered address set of a function map and the address-keyed caches of a FunctionManager.
    """

    def __init__(self) -> None: ...
    def copy(self) -> FunctionIndex: ...
    def add(self, addr: int) -> bool: ...
    def discard(self, addr: int) -> bool: ...
    def clear_addrs(self) -> None: ...
    def __contains__(self, addr: object) -> bool: ...
    def __len__(self) -> int: ...
    def addrs(self) -> list[int]: ...
    def next_addr(self, addr: int | None = None) -> int | None: ...
    def floor(self, addr: int) -> int | None: ...
    def ceiling(self, addr: int) -> int | None: ...
    def irange(
        self,
        minimum: int | None = None,
        maximum: int | None = None,
        inclusive: tuple[bool, bool] = (True, True),
        reverse: bool = False,
    ) -> list[int]: ...
    def set_returning(self, addr: int, v: bool | None) -> None: ...
    def is_nonreturning(self, addr: int) -> bool: ...
    def is_returning_unknown(self, addr: int) -> bool: ...
    def nonreturning_addrs(self) -> list[int]: ...
    def unknown_returning_addrs(self) -> list[int]: ...
    def set_block_count(self, addr: int, count: int) -> None: ...
    def block_count(self, addr: int) -> int | None: ...
    def block_counts(self) -> dict[int, int]: ...
    def addrs_with_block_count(self, count: int) -> set[int]: ...
    def name_changed(self, addr: int, old_name: str | None, new_name: str) -> None: ...
    def add_name_addr(self, name: str, addr: int) -> None: ...
    def add_old_name_addr(self, name: str, addr: int) -> None: ...
    def name(self, addr: int) -> str | None: ...
    def addrs_by_name(self, name: str, check_previous_names: bool = False) -> list[int]: ...
    def addrs_by_name_set(self, name: str, check_previous_names: bool = False) -> set[int]: ...
    def set_from_signature(self, addr: int, from_signature: str | None) -> None: ...
    def from_signature(self, addr: int) -> str | None: ...
    def addrs_from_signature(self, from_signature: str) -> set[int]: ...
    def add_key_func(self, func_type: str, addr: int) -> None: ...
    def key_func_addrs(self, func_type: str) -> set[int]: ...
    def key_funcs(self) -> dict[str, set[int]]: ...
    def index_info(self, addr: int, info: dict[str, Any]) -> None: ...
    def function_added(
        self, addr: int, returning: bool | None, block_count: int, from_signature: str | None, name: str
    ) -> None: ...
    def function_removed(self, addr: int, previous_names: list[str]) -> None: ...
    def clear_caches(self) -> None: ...
    def binary_name_cached(self, addr: int) -> tuple[bool, str | None]: ...
    def cache_binary_name(self, min_addr: int, max_addr: int, name: str | None) -> None: ...
    def plt_cached(self, addr: int) -> bool | None: ...
    def is_plt_addr(self, addr: int) -> bool: ...
    def cache_plt_range(self, min_addr: int, max_addr: int, plt_addrs: list[int] | None = None) -> None: ...
