from typing import Any

from .memory_data import MemoryDataStore

KIND_PYOBJ: int
KIND_UNKNOWN: int
KIND_BLOCK_TRIM: int
KIND_MD: int
KIND_TRIM: int
CLASS_OTHER: int
CLASS_BLOCK: int
CLASS_MD: int
CLASS_UNKNOWN: int
F_THUMB: int

# (index into pairs, key, kind, size, flags, payload, generation, sort, src)
type Spec = tuple[int, int, int, int | None, int, int, int, int, Any]

class CfbStore:
    """
    The interval store of a CFBlanket: address-keyed records, most of them native and materialized by the façade.
    """

    def __init__(self, block_type: type, md_type: type, unknown_type: type, arm: bool) -> None: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: int) -> bool: ...
    def add_obj(self, addr: int, obj: Any, want_events: bool) -> None: ...
    def add_objs(self, items: list[tuple[int, Any]], want_events: bool) -> None: ...
    def put_objs(self, items: list[tuple[int, Any]]) -> None: ...
    def set_unknown(self, addr: int, size: int, region: int, want_events: bool) -> None: ...
    def pop(self, addr: int) -> tuple[Any, Spec | None] | None: ...
    def mark_unknowns(self, regions: list[tuple[int, int, int]], want_events: bool) -> None: ...
    def mark_memory_data(self, md: MemoryDataStore, want_events: bool) -> None: ...
    def take_events(self) -> tuple[list[tuple[int, Any]], list[Spec]]: ...
    def cache_put(self, entries: list[tuple[int, int, Any]]) -> None: ...
    def get(self, addr: int) -> tuple[Any, Spec | None]: ...
    def floor_key(self, addr: int) -> int | None: ...
    def ceiling_key(self, addr: int) -> int | None: ...
    def keys(self) -> list[int]: ...
    def irange(
        self,
        minimum: int | None = None,
        maximum: int | None = None,
        inclusive: tuple[bool, bool] = (True, True),
        reverse: bool = False,
    ) -> list[int]: ...
    def scan(
        self, minimum: int | None, maximum: int | None, reverse: bool, limit: int | None = None
    ) -> tuple[list[tuple[int, Any]], list[Spec]]: ...
    def intervals(
        self, minimum: int | None = None, maximum: int | None = None
    ) -> list[tuple[int, int | None, int, str | None]]: ...
    def sort_name(self, sort: int) -> str | None: ...
    def clear(self) -> None: ...
    def state(self) -> tuple[list[tuple[int, int, int, int, int, int, Any]], list[str | None]]: ...
    def load_state(
        self, records: list[tuple[int, int, int, int, int, int, Any]], sort_names: list[str | None]
    ) -> None: ...
