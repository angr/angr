from collections.abc import Callable
from typing import Any

from .function_graph import FunctionGraph, NodeKind

LOG_REGISTER: int
LOG_GRAPH_NODE: int
LOG_ADD_EDGE: int
LOG_SET_CONFIRMED: int
LOG_REMOVE_EDGE: int
REG_NEW_LOCAL: int
REG_IN_GRAPH: int
CG_CALL: int
CG_FAKERET: int
CG_TRANSITION: int
CG_EXCEPTION: int

type NodeSpec = tuple[NodeKind, int, int, bool]

class RecoveryFunctions:
    """
    The scan-time function store of CFGFast: per-function records (flags, returning, info, a shared FunctionGraph),
    the non-returning sets and the callgraph, with an int-only recovery API mirroring FunctionManager._add_*.
    Every graph mutation bumps the function's generation and, while logging is enabled, appends an (op, a, b) log
    entry for the Python view to replay onto its networkx mirrors.
    """

    def __init__(self) -> None: ...
    def set_factory(self, factory: Callable[[int, bool], None]) -> None: ...
    def create(self, addr: int) -> FunctionGraph: ...
    def import_record(
        self,
        addr: int,
        graph: FunctionGraph,
        name: str,
        is_default_name: bool,
        previous_names: list[str],
        binary_name: str | None,
        is_syscall: bool,
        is_simprocedure: bool,
        is_plt: bool,
        is_alignment: bool,
        returning: bool | None,
        info: dict[str, Any],
    ) -> None: ...
    def remove(self, addr: int) -> bool: ...
    def contains(self, addr: int) -> bool: ...
    def __len__(self) -> int: ...
    def addrs(self) -> list[int]: ...
    def addrs_in_range(
        self,
        minimum: int | None = None,
        maximum: int | None = None,
        inclusive: tuple[bool, bool] = (True, True),
        reverse: bool = False,
    ) -> list[int]: ...
    def ceiling_addr(self, addr: int) -> int | None: ...
    def floor_addr(self, addr: int) -> int | None: ...
    def graph(self, addr: int) -> FunctionGraph: ...
    def reset_graph(self, addr: int) -> FunctionGraph: ...
    def generation(self, addr: int) -> int: ...
    def enable_log(self, addr: int) -> None: ...
    def disable_log(self, addr: int) -> None: ...
    def take_log(self, addr: int) -> list[tuple[int, int, int]]: ...
    def name(self, addr: int) -> str: ...
    def set_name(self, addr: int, name: str) -> None: ...
    def is_default_name(self, addr: int) -> bool: ...
    def set_is_default_name(self, addr: int, v: bool) -> None: ...
    def previous_names(self, addr: int) -> list[str]: ...
    def set_previous_names(self, addr: int, names: list[str]) -> None: ...
    def add_previous_name(self, addr: int, name: str) -> None: ...
    def binary_name(self, addr: int) -> str | None: ...
    def set_binary_name(self, addr: int, v: str | None) -> None: ...
    def is_syscall(self, addr: int) -> bool: ...
    def set_is_syscall(self, addr: int, v: bool) -> None: ...
    def is_simprocedure(self, addr: int) -> bool: ...
    def set_is_simprocedure(self, addr: int, v: bool) -> None: ...
    def is_plt(self, addr: int) -> bool: ...
    def set_is_plt(self, addr: int, v: bool) -> None: ...
    def is_alignment(self, addr: int) -> bool: ...
    def set_is_alignment(self, addr: int, v: bool) -> None: ...
    def returning(self, addr: int) -> bool | None: ...
    def set_returning(self, addr: int, v: bool | None) -> None: ...
    def info_get(self, addr: int, key: str) -> Any | None: ...
    def info_set(self, addr: int, key: str, value: Any) -> None: ...
    def info_del(self, addr: int, key: str) -> bool: ...
    def info_contains(self, addr: int, key: str) -> bool: ...
    def info_len(self, addr: int) -> int: ...
    def info_keys(self, addr: int) -> list[str]: ...
    def info_dict(self, addr: int) -> dict[str, Any]: ...
    def info_replace(self, addr: int, info: dict[str, Any]) -> None: ...
    def info_int(self, addr: int, key: str) -> int | None: ...
    def info_bool(self, addr: int, key: str) -> bool | None: ...
    def nonreturning_addrs(self) -> list[int]: ...
    def unknown_returning_addrs(self) -> list[int]: ...
    def is_nonreturning(self, addr: int) -> bool: ...
    def is_returning_unknown(self, addr: int) -> bool: ...
    def block_count(self, addr: int) -> int | None: ...
    def addrs_with_block_count(self, count: int) -> list[int]: ...
    def cg_add_node(self, n: int) -> None: ...
    def cg_add_edge(self, u: int, v: int, ty: int) -> bool: ...
    def cg_remove_node(self, n: int) -> bool: ...
    def cg_contains(self, n: int) -> bool: ...
    def cg_nodes(self) -> list[int]: ...
    def cg_number_of_nodes(self) -> int: ...
    def cg_number_of_edges(self) -> int: ...
    def cg_predecessors(self, n: int) -> list[int]: ...
    def cg_successors(self, n: int) -> list[int]: ...
    def cg_in_degree(self, n: int) -> int: ...
    def cg_out_degree(self, n: int) -> int: ...
    def cg_has_edge(self, u: int, v: int) -> bool: ...
    def cg_out_edges(self, n: int | None = None) -> list[tuple[int, int, int]]: ...
    def cg_in_edges(self, n: int) -> list[tuple[int, int, int]]: ...
    def cg_edge_types(self, u: int, v: int) -> list[int]: ...
    def cg_clear(self) -> None: ...
    def add_node(self, function_addr: int, node: NodeSpec, syscall: bool | None = None) -> None: ...
    def add_call_to(
        self,
        function_addr: int,
        from_node: NodeSpec,
        to_addr: int | None,
        retn_node: NodeSpec | None = None,
        syscall: bool = False,
        stmt_idx: int | None = None,
        ins_addr: int | None = None,
        return_to_outside: bool = False,
    ) -> None: ...
    def add_fakeret_to(
        self,
        function_addr: int,
        from_node: NodeSpec,
        to_node: NodeSpec,
        confirmed: bool | None = None,
        syscall: bool | None = None,
        to_outside: bool = False,
        to_function_addr: int | None = None,
    ) -> None: ...
    def remove_fakeret(self, function_addr: int, from_node: NodeSpec, to_node: NodeSpec) -> bool: ...
    def add_return_from(self, function_addr: int, from_node: NodeSpec) -> None: ...
    def add_transition_to(
        self,
        function_addr: int,
        from_node: NodeSpec,
        to_node: NodeSpec,
        ins_addr: int | None = None,
        stmt_idx: int | None = None,
        is_exception: bool = False,
    ) -> None: ...
    def add_outside_transition_to(
        self,
        function_addr: int,
        from_node: NodeSpec,
        to_node: NodeSpec | None,
        to_function_addr: int | None = None,
        ins_addr: int | None = None,
        stmt_idx: int | None = None,
        is_exception: bool = False,
    ) -> None: ...
    def add_return_from_call(
        self, function_addr: int, src_function_addr: int, to_node: NodeSpec, to_outside: bool = False
    ) -> None: ...
